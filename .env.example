# 环境变量示例 —— 复制成 .env 或直接在系统里设置（值不要提交到仓库）
#
#   Windows 永久设置：Win → 搜索"环境变量" → 编辑账户的环境变量 → 新建下面三条
#   PowerShell 临时设置（只对当前窗口有效）：
#       $env:DEEPSEEK_API_KEY="sk-..."
#       $env:OPENAI_BASE_URL="https://api.deepseek.com"
#       $env:MODEL_NAME="deepseek-flash"

# 必需：API 鉴权（手写版与框架版都用它）
DEEPSEEK_API_KEY=sk-你的key

# 框架版（LangGraph）需要：DeepSeek 的 OpenAI 兼容端点
OPENAI_BASE_URL=https://api.deepseek.com

# 框架版（LangGraph）需要：被测模型名
MODEL_NAME=deepseek-flash
